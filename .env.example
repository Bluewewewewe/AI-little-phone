# Supabase
# 主密钥：优先使用 SUPABASE_SERVICE_ROLE_KEY
# 兼容旧配置：如果没有 SERVICE_ROLE_KEY，会尝试使用 SUPABASE_SECRET_KEY
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_SECRET_KEY=your_service_role_key

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Bootstrap Admin（首次启动时自动创建首个管理员）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_me_immediately

# 用户审核通过后自动生成的邀请码数量（默认10）
INVITE_QUOTA_DEFAULT=10

# 环境: development | production
NODE_ENV=development
